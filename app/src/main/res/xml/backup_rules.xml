<!--
  Legacy (pre-API 31) backup rules mirroring data_extraction_rules.xml:
  nothing is backed up. Local-only data stays local.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
