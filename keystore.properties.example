# Copy this file to `keystore.properties` and fill in real values.
# `keystore.properties` is gitignored — do not commit your real one.
# CI does not read this file; CI reads SIGNING_KEY_* environment variables.

storeFile=C:/Users/Charles/your-keystore.jks
storePassword=your-keystore-password
keyAlias=your-key-alias
keyPassword=your-key-alias-password
